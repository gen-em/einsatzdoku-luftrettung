  },

  "muster": [
    { "id": "grundlage",   "ab": "klein", "pfade": ["server/**"], "proben": [],
      "anlass": "Auffangmuster: Jede Datei unter server/ laeuft durch die billigen Riegel. Sie traegt KEINE eigene Probe -- wer hier landet und sonst nirgends, hat keine zugeordnete Probe, und der Pruefstand sagt das." },

    { "id": "spur",        "ab": "klein", "pfade": ["server/spur_lib.php", "server/tag_spuren.php", "server/api/spur*.php"],
