    { "id": "komplett",    "ab": "klein", "pfade": ["server/komplett_lib.php"],
      "proben": ["komplettprobe"], "anlass": "count(null), F-S10-AP4-02" },
    { "id": "gpx",         "ab": "klein", "pfade": ["server/gpx_lib.php", "server/*export*.php", "server/assets/export.js"],
      "proben": ["gpxprobe"], "anlass": "Nr. 130" },
    { "id": "geraete",     "ab": "klein", "pfade": ["server/geraete_lib.php", "server/pair.php", "server/geraete*.php"],
      "proben": ["geraeteprobe", "kopplungsprobe"], "anlass": "Edge, das sich \"uhr\" nennt; Nr. 178, 180" },
    { "id": "mail",        "ab": "klein", "pfade": ["server/mail_lib.php", "server/email_lib.php"],
      "proben": ["mailprobe"], "anlass": "smtp_letzter_fehler()" },
    { "id": "sicherungsziel","ab": "klein", "pfade": ["server/sicherungsziel_lib.php", "server/admin_sicherungsziele.php"],
      "proben": ["versandprobe"], "anlass": "halb englische Meldungen" },
    { "id": "ratelimit",   "ab": "klein", "pfade": ["server/ratelimit_lib.php"],
      "proben": ["ratenprobe"], "anlass": "Stufe fiel nie zurueck" },
    { "id": "wartung",     "ab": "klein", "pfade": ["server/wartung_lib.php", "server/auth_guard.php"],
      "proben": ["wartungsprobe"], "anlass": "F-S8-P-04, Nr. 171" },
    { "id": "datenbank",   "ab": "klein", "pfade": ["server/db.php"],
      "proben": ["verbindungsprobe"], "anlass": "Nr. 210" },
    { "id": "krypto",      "ab": "klein", "pfade": ["server/serverkrypto_lib.php", "server/auth_salt.php", "server/assets/unlock.js", "server/assets/crypto.js"],
      "proben": ["anteilprobe", "containerprobe"], "anlass": "S10-Kern, F-S10-AP3-03" },
    { "id": "freigabe",    "ab": "klein", "pfade": ["server/*freigabe*.php", "server/*schluessel*.php"],
      "proben": ["freigabeprobe"], "anlass": "F-S2-F" },
    { "id": "sitzung",     "ab": "klein", "pfade": ["server/sitzung_lib.php", "server/session_lib.php", "server/assets/keyguard.js"],
      "proben": ["fristprobe", "abmelde-probe", "sitzungshaertung"], "anlass": "R44; Nr. 22; Nr. 205" },
    { "id": "kopfzeilen",  "ab": "klein", "pfade": ["server/kopfzeilen_lib.php"],
      "proben": ["cspprobe", "browserprobe-csp"], "anlass": "15.09.: Meldeweg tot" },
    { "id": "migration",   "ab": "klein", "pfade": ["server/schema.sql", "server/migration_lib.php", "server/update.php"],
      "proben": ["migrationsregister", "schemaprobe"], "anlass": "Nr. 238; Hausregel dreimal vergessen" },
    { "id": "install",     "ab": "klein", "pfade": ["server/install.php", "server/plattform_lib.php"],
      "proben": ["installweiche"], "anlass": "PP-1" },
    { "id": "rechtstext",  "ab": "klein", "pfade": ["docs/rechtstexte/*.md", "server/nutzungsbedingungen.php", "server/avv.php", "server/datenschutz.php"],
