# Build-Ausgaben der Uhr-App (werden bei jedem Kompilieren neu erzeugt)
watch/bin/
*.prg
*.prg.debug.xml
*.iq

# Lokale Server-Konfiguration (enthält Zugangsdaten — niemals ins Repo!)
server/config.php
server/install.lock
server/install-nachweis-*.txt

# Betriebssystem-Kram
.DS_Store
Thumbs.db

# Admin-Sicherungen entstehen nur auf dem Server (A8.2). Sie gehoeren nie ins
# Repo -- und der Deploy nimmt den Ordner ohnehin von der Synchronisation aus.
server/sicherungen/

# Erzeugnisse des Stilvergleichs (tools/stilvergleich/proben.py)
tools/stilvergleich/pruefstand/
tools/stilvergleich/__pycache__/
tools/wortliste/__pycache__/

# Erzeugnisse des Referenzdatensatz-Generators. Rund 25 MB, vollstaendig aus
# den Quelldaten ableitbar (ein Lauf dauert zwei Sekunden) und deterministisch
# -- eingecheckt ist stattdessen, was NICHT ableitbar ist: die Strassen-
# geometrie unter generator/routen/ und die Quelldaten selbst.
tools/referenzdatensatz/generator/ausgabe/
tools/referenzdatensatz/**/__pycache__/

# Zustand EINES Einspiellaufs: Einrichtungslink, Geraeteschluessel, vergebene
# Kennungen, Fortschritt. Fuer eine andere Installation ist davon nichts
# gueltig -- und der Einrichtungslink ist bis zu seiner Einloesung ein
# Zugang zum Konto.
tools/referenzdatensatz/einspielen/lauf.json
# Laufprotokoll des Referenz-Exports (Zeitpunkt und Dateinamen des letzten
# Laufs). Die erzeugten Dateien selbst gehoeren ins Repositorium (E-P1-12),
# das Protokoll ihres Entstehens nicht.
tools/referenzdatensatz/referenz/.export_lauf.json
