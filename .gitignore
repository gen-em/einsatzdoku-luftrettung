# Build-Ausgaben der Uhr-App (werden bei jedem Kompilieren neu erzeugt)
watch/bin/
*.prg
*.prg.debug.xml
*.iq

# Lokale Server-Konfiguration (enthält Zugangsdaten — niemals ins Repo!)
server/config.php
# Die Sicherung, die tools/mailprobe/ waehrend ihres Laufs anlegt. Sie liegt
# nur da, wenn die Probe nicht sauber zu Ende gekommen ist (kill -9, Behaelter
# weg) -- und sie enthaelt dann dieselben Zugangsdaten wie config.php.
server/config.php.mailprobe
server/install.lock
# Der Schalter des Wartungsmodus (S5 Paket W, E-S5W-02). Wie install.lock:
# Er ist ein ZUSTAND DIESER EINEN INSTALLATION und gehoert nicht ins
# Repositorium -- ein eingecheckter Schalter schloesse jede Installation, die
# den Stand auscheckt. Er steht zusaetzlich in der Ausnahmeliste des Deploys
# (.github/workflows/deploy.yml), sonst loeschte ihn der naechste Push --
# und zwar mitten im Update, fuer das er da ist.
server/wartung.lock
# Der Zaehler der Verbindungsgrenze (P5a/AP9, E-P5a-50). Wie wartung.lock:
# Er ist ein ZUSTAND DIESER EINEN INSTALLATION -- wie oft ihr Datenbankkonto
# in welcher Stunde abgewiesen wurde. Er steht in einer DATEI und nicht in
# app_state, weil er genau dann geschrieben werden muss, wenn die Datenbank
# keine Verbindung mehr annimmt. Zusaetzlich in der Ausnahmeliste beider
# FTPS-Schritte, sonst loeschte ihn der naechste Push.
server/ueberlast.json
# Die Sitzungsablage (Schritt 16, E-SA-05, Backlog Nr. 241). Wie wartung.lock
# und ueberlast.json ein ZUSTAND DIESER EINEN INSTALLATION -- und der
# heikelste davon: Der Dateiname einer Sitzungsdatei IST die
# Sitzungskennung, wer sie liest, ist angemeldet. Ein eingecheckter Ordner
# waere eine Sitzung im Repositorium.
#
# Der Ordner steht zusaetzlich in der Ausnahmeliste beider FTPS-Schritte,
# sonst loeschte ihn der naechste Push -- und meldete damit bei jedem Deploy
# alle an. ACHTUNG, STAND 20.09.2026: Dort ist er NOCH NICHT eingetragen; der
# Eintrag gehoert zu Kette II (E-KH-20, AP5 dort) und ist dort angemeldet.
#
# Als einziger dieser Eintraege liegt er im Web-Wurzelverzeichnis. Was ihn
# dort deckt, ist die Punktregel in server/.htaccess (jeder Pfad mit
# fuehrendem Punkt -> 403, ausser .well-known/) und auf nginx, wo sie nicht
# gilt, allein der Modus 0700.
server/.sitzungen/
server/install-nachweis-*.txt
server/wiederher-nachweis-*.txt

# Arbeitsablage fuer Workflow-Skripte (Bestandsaufnahmen). Sie muessen im
# Arbeitsverzeichnis liegen, damit das Werkzeug sie lesen darf — gehoeren aber
# nicht ins Repositorium: Es sind Notizen eines Laufs, keine Quelltexte.
.wf/

# Betriebssystem-Kram
.DS_Store
Thumbs.db

# Admin-Sicherungen entstehen nur auf dem Server (A8.2). Sie gehoeren nie ins
# Repo -- und der Deploy nimmt den Ordner ohnehin von der Synchronisation aus.
server/sicherungen/

# Die APK-Dateien der Android-Apps (S4/A1, E-S4-16). Sie liegen NUR auf dem
# Server: Der Betreiber laedt sie per FTPS dorthin, die Downloadseite zeigt,
# was liegt. Nicht ins Repositorium -- ein signiertes APK ist ein Erzeugnis,
# kein Quelltext, und es waere bei jeder Fassung ein zweistelliges MB im
# Verlauf. Der Ordner steht zusaetzlich in der Ausnahmeliste des Deploys
# (.github/workflows/), sonst loeschte ihn der naechste Push -- dasselbe
# Muster wie config.php und sicherungen/.
server/apk/

# Erzeugnisse des Stilvergleichs (tools/stilvergleich/proben.py)
tools/stilvergleich/pruefstand/
tools/stilvergleich/__pycache__/
tools/wortliste/__pycache__/
# Ein Muster statt einer Liste: Die drei Eintraege davor sind einzeln
# gewachsen, und tools/vollstaendigkeit/ und tools/screenshots/ fehlten —
# beide erzeugen inzwischen ebenfalls Bytecode (O10).
tools/**/__pycache__/

# Erzeugnisse des Referenzdatensatz-Generators. Rund 25 MB, vollstaendig aus
# den Quelldaten ableitbar (ein Lauf dauert zwei Sekunden) und deterministisch
# -- eingecheckt ist stattdessen, was NICHT ableitbar ist: die Strassen-
# geometrie unter generator/routen/ und die Quelldaten selbst.
tools/referenzdatensatz/generator/ausgabe/
tools/referenzdatensatz/**/__pycache__/

# Zustand EINES Einspiellaufs: Einrichtungslink, Geraeteschluessel, vergebene
# Kennungen, Fortschritt. Fuer eine andere Installation ist davon nichts
# gueltig -- und der Einrichtungslink ist bis zu seiner Einloesung ein
# Zugang zum Konto.
tools/referenzdatensatz/einspielen/lauf.json
# Wiederherstellungsschluessel, geschrieben von passwort_setzen.mjs.
#
# `*rc.json` UND NICHT `*_rc.json`. Der frühere Eintrag war erkennbar fuer
# genau diese Datei gedacht und verfehlte sie: LIESMICH.md 39 und
# einspielen.py 109 weisen beide `rc.json` an, ohne Praefix.
#
# Warum das Muster erweitert wurde und nicht der Dateiname in der Anleitung
# geaendert: Ein Dateiname wirkt erst, wenn ihn jemand liest. Auf Maschinen,
# auf denen aus frueheren Laeufen schon eine `rc.json` liegt, und bei jedem,
# der den Aufruf aus Gewohnheit oder aus einem aelteren Commit kopiert, wirkt
# er gar nicht. Ein Muster wirkt ohne Zutun.
#
# Im dokumentierten Ablauf gehoert der Schluessel zu einem Wegwerfkonto und
# schuetzt nichts. `passwort_setzen.mjs` nimmt aber jede URL, nicht nur
# 127.0.0.1 — wer das Skript gegen eine echte Installation richtet, hat einen
# passwortaequivalenten Schluessel in der Datei. Genau diese Person liest die
# Anleitung nicht noch einmal.
tools/referenzdatensatz/einspielen/*rc.json
#
# UND DASSELBE OHNE VERZEICHNIS (13.09.2026, Backlog-Runde 3 / AP9). Die Regel
# darueber ist an `einspielen/` gebunden, der Dateiname aber ist ein RELATIVER
# Pfad im Aufruf: `node einspielen/passwort_setzen.mjs '<Link>' '<Passwort>'
# rc.json` legt ihn dorthin, wo die Aufrufende steht — die Anleitung ruft aus
# `tools/referenzdatensatz/`, also eine Ebene hoeher, und dort griff die Regel
# nicht. Gefunden, weil der Stop-Hook die Datei als unverfolgt meldete, nicht
# weil jemand sie bemerkt haette.
#
# Genau die Fortsetzung des Arguments oben: Ein Muster wirkt ohne Zutun -- aber
# nur, soweit es reicht. `**/rc.json` trifft den Dateinamen in JEDEM
# Verzeichnis und ist bewusst der exakte Name statt `*rc.json`: Letzteres
# verschluckte auch `.eslintrc.json` und Geschwister. Heute gibt es davon
# keine im Repositorium (nachgesehen), morgen vielleicht schon.
**/rc.json
# Laufprotokoll des Referenz-Exports (Zeitpunkt und Dateinamen des letzten
# Laufs). Die erzeugten Dateien selbst gehoeren ins Repositorium (E-P1-12),
# das Protokoll ihres Entstehens nicht.
tools/referenzdatensatz/referenz/.export_lauf.json
tools/screenshots/ausgabe/
# Bericht und Bilder der Klickprobe (tools/klickprobe/probe.mjs). Sie
# entstehen bei jedem Lauf neu und gehoeren als Zahl ins Pruefdokument, nicht
# als Datei ins Repositorium -- dieselbe Regel wie beim Bilderlauf daneben.
tools/klickprobe/ausgabe/
# Belegbild des Betriebslaufs (S10/AP3) — entsteht bei jedem Lauf neu
tools/anteilprobe/ausgabe-*.png
# Bildschirmabzuege des Emulators (android/werkzeuge/emulator.sh, Vorgabe
# `./emulator-bilder/`). Sie entstehen bei JEDEM Lauf neu und in Menge --
# ein Paket wirft ein Dutzend ab, jedes rund 100 kB. Was davon etwas belegt,
# wird bewusst einzeln nach `android/mockups/` uebernommen und im Konzept
# oder in der Dokumentation verwiesen; der Rest ist Arbeitsstand.
emulator-bilder/

# Zustandsdateien der Auslieferungskette (Nr. 213). Die FTP-Aktion laedt sie
# waehrend eines Laufs herunter; auf einem Entwicklungsrechner haben sie
# nichts verloren, und im Repositorium erst recht nicht -- sie nennen jede
# ausgelieferte Datei mit Pfad und Hash.
.ftp-deploy-sync-state.json
.deploy-state-*.json
