<?xml version="1.0"?>
<!-- Hinweis: Die UUID beim ersten Projekt-Setup durch eine eigene ersetzen
     (VS Code: "Monkey C: New Project" erzeugt eine; oder uuidgen). -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6" type="watch-app"
                    name="@Strings.AppName" entry="HemsApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.1.0">
        <iq:products>
            <!-- Vor jedem neuen Geraet: Eingabeverhalten mit
                 tools/eingabe-probe messen und in docs/Geraete-Eingabe.md
                 festhalten. Ohne Langdruck-Faehigkeit ist die App nicht
                 bedienbar. -->
            <iq:product id="fenix6pro"/>   <!-- 260x260, 5 Tasten, kein Touch -->
            <iq:product id="fr945"/>       <!-- 240x240, 5 Tasten, kein Touch -->
            <iq:product id="venu3s"/>      <!-- 390x390, 2 nutzbare Tasten, Touch -->
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>deu</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
