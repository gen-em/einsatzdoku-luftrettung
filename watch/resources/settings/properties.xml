<properties>
    <!-- Adresse der Installation. Die Domain genuegt — Schema und
         /ingest.php ergaenzt die App selbst; vollstaendige URLs bleiben
         ebenfalls gueltig.
         VORGABE IST DIE OEFFENTLICHE INSTALLATION (R36, E-R49-8). Bis 2.0.0
         stand hier nichts, mit der Begruendung "jede Installation hat ihren
         eigenen Server". Das stimmte, als es nur Selbsthoster gab; seit es
         eine oeffentliche Installation gibt, kostete es jede Trägerin einen
         Weg durch die Garmin-Connect-Einstellungen, bevor sie ueberhaupt
         koppeln konnte. Selbsthoster tragen hier ihre eigene Domain ein —
         das Feld bleibt ueberschreibbar. -->
    <property id="serverUrl" type="string">nadoku.gen-em.org</property>
    <!-- Werden beim Koppeln automatisch gefuellt — normalerweise nichts eintragen. -->
    <property id="deviceId"  type="string"></property>
    <property id="apiKey"    type="string"></property>
    <!-- Touchbedienung. Wirkt nur auf Geraeten, die UP/DOWN UND Touch haben
         (Fenix 7 und neuer). Auf Geraeten ohne UP/DOWN wird der Wert
         ignoriert — ohne Touch waeren sie unbedienbar. -->
    <property id="touchEnabled" type="boolean">true</property>
    <!-- Welche Bildmarke der Startbildschirm zeigt:
         0 = luftgebunden (Vorgabe), 1 = bodengebunden, 2 = wechselnd.
         ZAHLEN, KEINE WOERTER: settingConfig type="list" liest die Werte als
         Zahl ein und bricht bei Text ab ("For input string: ..."). Die
         Bedeutung tragen Const.LOGO_* im Code.
         Die Weboberflaeche kennt dieselbe Wahl je Konto; auf der Uhr wird sie
         hier gesetzt, weil die Uhr die Kontoeinstellung nicht kennt.
         "Wechselnd" wuerfelt EINMAL JE APP-START, nicht bei jedem Zeichnen —
         sonst spraenge das Bild waehrend des Dienstes. -->
    <property id="logoWahl" type="number">0</property>
</properties>
