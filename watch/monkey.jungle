project.manifest = manifest.xml

# Geraeteprofil zur Bauzeit: Welche Tasten hat das Geraet ueberhaupt?
# Zur Laufzeit ist das nicht ermittelbar — Connect IQ kennt keine Abfrage
# "hat UP/DOWN". Deshalb liefert je Profil eine eigene DeviceProfile.mc die
# Konstante HAS_UP_DOWN. Gemessene Grundlage: docs/Geraete-Eingabe.md.
#
# WICHTIG: Die Pfade werden VOLLSTAENDIG zugewiesen, nicht mit
# $(<geraet>.sourcePath) erweitert. Ein Selbstbezug faellt auf eine Vorgabe
# zurueck, die alle source*-Ordner einsammelt — dann landen beide Profile im
# Build und der Compiler meldet "Redefinition of HAS_UP_DOWN".
base.sourcePath      = source;source-tasten5

fenix6pro.sourcePath = source;source-tasten5
fr945.sourcePath     = source;source-tasten5

# Geraete mit Touch und ohne eigene UP/DOWN-Tasten brauchen das
# Drei-Tasten-Profil. Wer das vergisst, merkt es NICHT beim Uebersetzen:
# Die App baut sauber und ist auf dem Geraet unbedienbar.
# Erzeugt mit: geraeteklassen.py --bloecke
approachs50.sourcePath = source;source-tasten3
approachs7042mm.sourcePath = source;source-tasten3
approachs7047mm.sourcePath = source;source-tasten3
d2air.sourcePath = source;source-tasten3
d2airx10.sourcePath = source;source-tasten3
venu.sourcePath = source;source-tasten3
venu2.sourcePath = source;source-tasten3
venu2plus.sourcePath = source;source-tasten3
venu2s.sourcePath = source;source-tasten3
venu3.sourcePath = source;source-tasten3
venu3s.sourcePath = source;source-tasten3
venud.sourcePath = source;source-tasten3
vivoactive5.sourcePath = source;source-tasten3

# Launcher-Symbol und Bildmarke: eigene Ressourcenordner je Groesse.
# Gleiche Regel wie oben bei sourcePath: vollstaendig zuweisen, der spaetere
# Pfad gewinnt bei gleichnamigen Ressourcen-IDs.
#
# resources-icon<N>  traegt NUR das Launcher-Symbol in N Pixeln. Neun Groessen
#                    verlangen die 99 Geraete (35, 36, 40, 54, 56, 60, 61, 65,
#                    70); 40 liegt im Grundordner, weil 51 Geraete genau das
#                    verlangen. Fehlt die passende, skaliert monkeyc und meldet
#                    es als Warnung — hochskaliert wird das Symbol unscharf.
# resources-marke<K> traegt NUR die Bildmarke in einer Kachel von K Pixeln.
#                    70 liegt im Grundordner (Bezugsgeraet fenix6pro, 260 px).
#
# Erzeugt mit: geraeteklassen.py --bloecke
# Die Bilder selbst: tools/uhr-bilder/erzeugen.sh
base.resourcePath    = resources

fr55.resourcePath = resources;resources-icon35
fenix5s.resourcePath = resources;resources-icon36
fenixchronos.resourcePath = resources;resources-icon36
fr265s.resourcePath = resources;resources-icon60
venu2s.resourcePath = resources;resources-icon61
approachs50.resourcePath = resources;resources-icon56
approachs7042mm.resourcePath = resources;resources-icon60
d2air.resourcePath = resources;resources-icon60
descentg2.resourcePath = resources;resources-icon60
descentmk343mm.resourcePath = resources;resources-icon60
epix2pro42mm.resourcePath = resources;resources-icon60
fr165.resourcePath = resources;resources-icon54
fr165m.resourcePath = resources;resources-icon54
fr170.resourcePath = resources;resources-icon54
fr170m.resourcePath = resources;resources-icon54
fr57042mm.resourcePath = resources;resources-icon54
fr70.resourcePath = resources;resources-icon54
marq2.resourcePath = resources;resources-icon60
marq2aviator.resourcePath = resources;resources-icon60
venu.resourcePath = resources;resources-icon60
venu3s.resourcePath = resources;resources-icon70;resources-marke105
venud.resourcePath = resources;resources-icon60
vivoactive5.resourcePath = resources;resources-icon56
d2airx10.resourcePath = resources;resources-icon70;resources-marke105
d2mach1.resourcePath = resources;resources-icon60
epix2.resourcePath = resources;resources-icon60
epix2pro47mm.resourcePath = resources;resources-icon60
fenix843mm.resourcePath = resources;resources-icon60
fenix943mm.resourcePath = resources;resources-icon60
fenix9pro43mm.resourcePath = resources;resources-icon60
fenixe.resourcePath = resources;resources-icon60
fr265.resourcePath = resources;resources-icon60
venu2.resourcePath = resources;resources-icon70;resources-marke105
venu2plus.resourcePath = resources;resources-icon70;resources-marke105
approachs7047mm.resourcePath = resources;resources-icon70;resources-marke105
d2mach2.resourcePath = resources;resources-icon65
d2mach2pro.resourcePath = resources;resources-icon65
descentmk351mm.resourcePath = resources;resources-icon60
epix2pro51mm.resourcePath = resources;resources-icon60
fenix847mm.resourcePath = resources;resources-icon65
fenix8pro47mm.resourcePath = resources;resources-icon65
