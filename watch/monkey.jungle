project.manifest = manifest.xml

# Geraeteprofil zur Bauzeit: Welche Tasten hat das Geraet ueberhaupt?
# Zur Laufzeit ist das nicht ermittelbar — Connect IQ kennt keine Abfrage
# "hat UP/DOWN". Deshalb liefert je Profil eine eigene DeviceProfile.mc die
# Konstante HAS_UP_DOWN. Gemessene Grundlage: docs/Geraete-Eingabe.md.
#
# WICHTIG: Die Pfade werden VOLLSTAENDIG zugewiesen, nicht mit
# $(<geraet>.sourcePath) erweitert. Ein Selbstbezug faellt auf eine Vorgabe
# zurueck, die alle source*-Ordner einsammelt — dann landen beide Profile im
# Build und der Compiler meldet "Redefinition of HAS_UP_DOWN".
base.sourcePath      = source;source-tasten5

fenix6pro.sourcePath = source;source-tasten5
fr945.sourcePath     = source;source-tasten5

# Geraete mit Touch und ohne eigene UP/DOWN-Tasten brauchen das
# Drei-Tasten-Profil. Wer das vergisst, merkt es NICHT beim Uebersetzen:
# Die App baut sauber und ist auf dem Geraet unbedienbar.
# Getrennte Ordner statt Kombinationen: Die Ordnerzahl gewinnt dabei nichts
# (8 + 3 gegen ebenfalls 11), die Pflege schon — zusammengelegt laege dieselbe
# 101er Kachel in fuenf Ordnern, und eine verschobene Stufengrenze schnitte den
# ganzen Satz neu.
#
# Erzeugt mit: geraeteklassen.py --bloecke
approachs50.sourcePath = source;source-tasten3
approachs7042mm.sourcePath = source;source-tasten3
approachs7047mm.sourcePath = source;source-tasten3
d2air.sourcePath = source;source-tasten3
d2airx10.sourcePath = source;source-tasten3
venu.sourcePath = source;source-tasten3
venu2.sourcePath = source;source-tasten3
venu2plus.sourcePath = source;source-tasten3
venu2s.sourcePath = source;source-tasten3
venu3.sourcePath = source;source-tasten3
venu3s.sourcePath = source;source-tasten3
venud.sourcePath = source;source-tasten3
vivoactive5.sourcePath = source;source-tasten3

# Launcher-Symbol und Bildmarke: eigene Ressourcenordner je Groesse.
# Gleiche Regel wie oben bei sourcePath: vollstaendig zuweisen, der spaetere
# Pfad gewinnt bei gleichnamigen Ressourcen-IDs.
#
# resources-icon<N>  traegt NUR das Launcher-Symbol in N Pixeln. Neun Groessen
#                    verlangen die 99 Geraete (35, 36, 40, 54, 56, 60, 61, 65,
#                    70); 40 liegt im Grundordner, weil 51 Geraete genau das
#                    verlangen. Fehlt die passende, skaliert monkeyc und meldet
#                    es als Warnung — hochskaliert wird das Symbol unscharf.
# resources-marke<K> traegt NUR die Bildmarke in einer Kachel von K Pixeln.
#                    VIER Stufen (60, 73, 101, 118) ueber die zehn
#                    vorkommenden Displayhoehen; 73 liegt im Grundordner, es
#                    ist die Stufe des Bezugsgeraets fenix6pro. Zielwert sind
#                    27 % der Displayhoehe. Warum vier und nicht drei, fuenf
#                    oder zehn: tools/uhr-bilder/erzeugen.sh.
#
# Erzeugt mit: geraeteklassen.py --bloecke
# Die Bilder selbst: tools/uhr-bilder/erzeugen.sh
base.resourcePath    = resources

fr55.resourcePath = resources;resources-icon35;resources-marke60
fenix5s.resourcePath = resources;resources-icon36;resources-marke60
fenixchronos.resourcePath = resources;resources-icon36;resources-marke60
