<?xml version="1.0" encoding="utf-8"?>
<!--
    Vordergrund des adaptiven Symbols — wortgleich zum Handy
    (handy/src/main/res/drawable/symbol_vordergrund.xml), und die Begruendung
    steht dort.

    Kurz: Bis 0.13.0 stand hier ein Eintrag von FEST 52 x 33 dp in einer
    108-dp-Kachel. Das stimmt nur, wenn die Kachel tatsaechlich 108 dp gross
    gezeichnet wird; ein Startprogramm zeichnet sie mit 48 bis 60 dp, und auf
    einer Uhr eher kleiner. Ein festes Motiv fuellt dann die Flaeche oder ragt
    ueber den sichtbaren Kreis hinaus (Backlog Nr. 81). Bruchteile skalieren
    mit: links und rechts je 25,93 %, oben und unten je 34,93 % — der
    Innenraum traegt das Seitenverhaeltnis der Vorlage (500 x 313 px).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/marke_luft_weiss"
    android:insetLeft="25.93%"
    android:insetRight="25.93%"
    android:insetTop="34.93%"
    android:insetBottom="34.93%" />
