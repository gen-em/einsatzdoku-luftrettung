<?xml version="1.0" encoding="utf-8"?>
<!--
    NAdoku Handy.

    ALLOWBACKUP IST AUS (E-S4-13). Mit `true` wandern die App-Daten — und
    damit die verschluesselte Ablage von `device_id` und `api_key` — in die
    Geraetesicherung und von dort auf ein anderes Geraet. Der Schluessel, mit
    dem sie verschluesselt sind, liegt im Android Keystore und ist nicht
    exportierbar; die Kopie waere also unbrauchbar. Aber sie waere vorhanden,
    und ein Geheimnis, das an einer Stelle mehr liegt als noetig, ist ein
    Geheimnis weniger. Die Kopplung ist ohnehin in einer Minute neu gemacht.

    Die Berechtigungen wachsen mit den Arbeitspaketen: Ortung und
    Vordergrunddienst kommen mit B3, die Kamera fuer den QR-Scan mit B2. Hier
    steht bewusst nur, was der Stand B1 wirklich braucht — eine Berechtigung
    auf Vorrat waere eine Frage an die NutzerIn, die die App noch nicht
    beantworten kann.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Die Kamera dient AUSSCHLIESSLICH dem Kopplungs-QR (E-S4-15), und die
        Freigabe wird erst in dem Augenblick erfragt, in dem jemand "QR-Code
        scannen" antippt — nicht beim Erststart. Wer sie ablehnt, tippt den
        Code von Hand ein; die App bleibt vollstaendig benutzbar.

        `required="false"`: Ein Geraet ohne Kamera kann NAdoku trotzdem
        benutzen. Mit `true` verschwaende die App im Store fuer solche Geraete
        — und das waere fuer einen Kameraschwenk, der eine Abkuerzung ist, die
        falsche Aussage.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/datensicherung"
        android:fullBackupContent="false"
        android:icon="@mipmap/symbol"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/symbol"
        android:supportsRtl="true"
        android:theme="@style/Theme.NAdoku">

        <activity
            android:name=".handy.HauptActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NAdoku">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
