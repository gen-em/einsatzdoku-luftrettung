<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher-Symbol als adaptives Symbol (ab Android 8.0).

    ES LIEGT IM GRUNDORDNER `mipmap/`, nicht in `mipmap-anydpi-v26/`. Die
    uebliche Ablage mit `-v26` haelt eine zweite, flache Fassung fuer aeltere
    Staende bereit; unser minSdk ist 26 (Handy) bzw. 30 (Uhr), es gibt also
    kein Zielgeraet ohne adaptive Symbole. Lint meldet die Stufe `-v26` unter
    diesen Umstaenden als ueberfluessig ["ObsoleteSdkInt"], und sie ist es.

    DAS SYMBOL IST IMMER DIE LUFTMARKE, und zwar aus demselben Grund wie an der
    Garmin-Uhr (tools/uhr-bilder/LIESMICH.md): Es wird beim Uebersetzen in die
    App gebacken und kann der Einstellung "Logo-Wahl" nicht folgen — eine App
    hat im Geraetemenue genau ein Symbol. Die Wahl wirkt in der App selbst.

    Der Vordergrund ist die weisse Fassung auf dunkelblauem Grund; das ist die
    Einsatzregel aus Design.md 2.3 fuer dunklen Grund.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/marke_dunkelblau" />
    <foreground android:drawable="@drawable/symbol_vordergrund" />
    <monochrome android:drawable="@drawable/symbol_vordergrund" />
</adaptive-icon>
