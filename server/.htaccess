# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Zwei Ordner, die es im Webroot gibt und die niemand ueber HTTP braucht
# (Backlog Nr. 129, K-9).
#
#   apk/    die signierten Android-Pakete. `apk.php` liefert sie aus und
#           verlangt dafuer eine Anmeldung -- der ORDNER tat das nicht, und
#           die Dateinamen sind vorhersagbar (`nadoku-0.13.0.apk`).
#           `Technik.md` 4.97g sagte "nur angemeldet"; das galt fuer die
#           Seite, nicht fuer den Ordner.
#   demo/   `fixture.json.gz` mit dem Schluesselmaterial des Demo-Kontos.
#           Harmlos -- das Passwort steht im Handbuch --, aber unnoetig.
#
# EINE ZEILE STATT EINER LAUFZEITSPERRE: mod_rewrite laeuft hier schon
# (HTTPS-Zwang darueber), und beide Ordner werden ausschliesslich vom
# PHP-Code gelesen (`readfile()` in apk.php, `file_get_contents()` in
# demo_lib.php). Die Sperre kostet die Anwendung also nichts.
#
# NACH dem HTTPS-Zwang, nicht davor: Ein Aufruf ueber HTTP soll zuerst auf
# HTTPS umgeleitet werden und dort die 403 bekommen -- sonst antwortet der
# unverschluesselte Kanal mit einer Auskunft.
RewriteRule ^(apk|demo)(/|$) - [F,L]

# Sensible Dateien niemals ausliefern
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|db\.php|smtp\.php|auth_guard\.php|install\.lock)$">
  Require all denied
</FilesMatch>

# Nachweisdatei der Ersteinrichtung (M1-11). ZWEITE Schranke, nicht die erste:
# Die Kennung steht bereits im DATEINAMEN und ist damit auch dann nicht zu
# erraten, wenn diese Regel nicht greift (anderer Webserver, .htaccess
# abgeschaltet). Ein Verzeichnislisting liefert kein verbreiteter Webserver
# von selbst.
<FilesMatch "^install-nachweis-.*\.txt$">
  Require all denied
</FilesMatch>

# Dasselbe fuer den Nachweis der Wiederherstellung (S2/AP8). Er entsteht nur
# auf einer LEEREN Installation oder waehrend eines laufenden Einspielens --
# also genau dann, wenn es noch keine Anmeldung gibt, die ihn schuetzen
# koennte. Die erste Fassung dieser Datei kannte ihn nicht; die Regel war
# damit fuer den einen Fall nicht da, fuer den es sie gibt.
<FilesMatch "^wiederher-nachweis-.*\.txt$">
  Require all denied
</FilesMatch>

# Security-Header -- SEIT WEB 20.7.0 NUR NOCH FUER DAS, WAS NICHT DURCH PHP
# LAEUFT (P5a/AP4, E-P5a-15).
#
# WAS SICH GEAENDERT HAT UND WARUM. Bis Web 20.6.0 standen hier vier
# Kopfzeilen mit `Header always set` -- und `set` ERSETZT, was PHP gesetzt
# hat. Solange PHP nichts setzte, war das die einzige Quelle und richtig so.
# Seit `kopfzeilen_lib.php` setzt PHP sie selbst, und zwar auf JEDEM
# Webserver: Diese Datei liest nur Apache. Auf nginx, Caddy oder LiteSpeed
# stand die Installation vorher ohne `nosniff`, ohne `Referrer-Policy`, ohne
# `X-Frame-Options` und ohne HSTS da, und niemand sah es.
#
# `setifempty` STATT `set`: Damit fuehrt PHP, wo PHP laeuft, und diese Datei
# springt nur dort ein, wo es nicht laeuft -- bei den statischen Dateien unter
# `assets/` (Stylesheet, Schriften, Symbole, Skripte). Genau die brauchen
# `nosniff` ebenso, und genau die bekommen es von PHP nie.
#
# `Strict-Transport-Security` IST HIER GANZ VERSCHWUNDEN, und das ist die
# unangenehme Zeile: Sie stand auf `max-age=31536000` -- ein Jahr. Seit AP4
# ist die Dauer eine EINSTELLUNG (Betrieb -> Servereinstellungen, Vorgabe
# **ein Tag**, Stufen 1/7/365). Zwei Stellen fuer dieselbe Kopfzeile waeren
# auf Apache keine Wiederholung, sondern ein Ueberschreiben: Die Einstellung
# haette nichts bewirkt und trotzdem einen Wert angezeigt.
#
# **Der Preis, benannt:** Auf einer Installation, die bisher ein Jahr gesendet
# hat, sinkt die Bindung nach dem Deploy auf einen Tag, bis jemand den Wert
# hochstellt. Das steht im Pruefdokument als Punkt fuer die Betreiberin und
# als Hinweis an der Einstellung selbst.
Header always setifempty X-Content-Type-Options "nosniff"
Header always setifempty X-Frame-Options "DENY"
# strict-origin-when-cross-origin: sendet die Herkunft (ohne Pfad) auch an
# fremde Domains -> Kartenkacheln von OpenStreetMap laden wieder.
Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"