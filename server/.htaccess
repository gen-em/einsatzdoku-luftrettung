# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Zwei Ordner, die es im Webroot gibt und die niemand ueber HTTP braucht.
#
#   apk/    die signierten Android-Pakete. `apk.php` liefert sie aus und
#           verlangt dafuer eine Anmeldung -- der ORDNER taete das nicht, und
#           die Dateinamen sind vorhersagbar (`nadoku-0.13.0.apk`).
#   demo/   `fixture.json.gz` mit dem Schluesselmaterial des Demo-Kontos.
#           Harmlos -- das Passwort steht im Handbuch --, aber unnoetig.
#
# EINE ZEILE STATT EINER LAUFZEITSPERRE: mod_rewrite laeuft hier schon
# (HTTPS-Zwang darueber), und beide Ordner werden ausschliesslich vom
# PHP-Code gelesen (`readfile()` in apk.php, `file_get_contents()` in
# demo_lib.php). Die Sperre kostet die Anwendung also nichts.
#
# NACH dem HTTPS-Zwang, nicht davor: Ein Aufruf ueber HTTP soll zuerst auf
# HTTPS umgeleitet werden und dort die 403 bekommen -- sonst antwortet der
# unverschluesselte Kanal mit einer Auskunft.
RewriteRule ^(apk|demo)(/|$) - [F,L]

# PUNKTDATEIEN NIEMALS AUSLIEFERN -- MIT GENAU EINER AUSNAHME.
#
# ANLASS. Die Auslieferungskette benutzt SamKirkland/FTP-Deploy-Action, und
# die legt ihre Zustandsdatei `.ftp-deploy-sync-state.json` in das
# ZIELVERZEICHNIS -- also hierher, neben diese Datei. Darin steht je
# ausgelieferter Datei Pfad, Groesse und Hash, dazu der Zeitpunkt der letzten
# Auslieferung. Kein Geheimnis (config.php und Konsorten stehen in der
# Ausnahmeliste der Kette und damit nicht darin), aber die vollstaendige
# Struktur und -- ueber die Hashes -- der Versionsstand JEDER EINZELNEN DATEI.
# Die Zeilen darueber nennen sieben Dateien und zwei Muster beim Namen; eine
# Punktdatei war nicht darunter, weil niemand mit ihr gerechnet hatte.
#
# EINE REGEL STATT EINES WEITEREN NAMENS. `state-name` in der Kette legt die
# Datei inzwischen ausserhalb des Webroots ab -- diese Regel ist die ZWEITE
# Schranke, wie bei den Nachweis-Dateien unten: Sie greift auch dann, wenn
# der Kaefig des FTP-Zugangs kein `../` erlaubt und die Datei deshalb doch
# wieder hier landet, und sie greift fuer jede kuenftige Punktdatei, an die
# ebenfalls niemand denkt (`.env`, `.git/`, `.DS_Store`).
#
# DIE AUSNAHME IST NICHT SCHMUCK: `.well-known/` traegt die
# ACME-Herausforderung der Zertifikatserneuerung. Eine pauschale Sperre
# nimmt der Anlage in spaetestens 90 Tagen das Zertifikat, und zwar lautlos
# -- niemand ruft diesen Pfad von Hand auf. Der negative Vorgriff
# `(?!well-known/)` laesst genau ihn durch.
#
# WAS DIE REGEL BEWEISBAR MACHT: `[F]` antwortet 403, OB DIE DATEI DA IST
# ODER NICHT -- mod_rewrite laeuft vor der Dateisuche. Damit laesst sich die
# Sperre messen und nicht nur glauben: Stufe 2 der Kette fragt beide Pfade
# ab und verlangt 403 fuer die Zustandsdatei und **404, nicht 403** fuer
# `.well-known/`. Ein 404 auf die erste hiesse „nichts da" und bewiese
# nichts; ein 403 auf die zweite hiesse, die Zertifikatserneuerung ist tot.
#
# Ein blosses `/.well-known` OHNE Schraegstrich faellt unter die Sperre. Das
# ist gewollt: ACME fragt immer `/.well-known/acme-challenge/<Token>`, und
# ein Verzeichnislisting braucht dort niemand.
#
# NACH dem HTTPS-Zwang, aus demselben Grund wie die Zeile darueber.
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# Sensible Dateien niemals ausliefern
#
# `config\.php.*` UND NICHT NUR `config\.php`: Jede Kopie daneben --
# `config.php.bak`, `config.php~` eines Editors -- endet nicht auf `.php`,
# laeuft also nicht durch PHP und kaeme als Text heraus, samt
# Datenbankzugang, Serverschluessel und Anteil. Die Proben legen ihre
# Sicherung ausserhalb von `server/` ab; diese Zeile ist der zweite Riegel
# fuer alles, was sonst noch so heisst. `(?i)` und `#?`: `Config.php.bak`
# kaeme sonst durch, ebenso die Sicherung `#config.php#` von Emacs;
# `.#config.php` faengt schon die Punktregel oben.
<FilesMatch "^(?i:#?config\.php.*|config\.example\.php|schema\.sql|db\.php|smtp\.php|auth_guard\.php|install\.lock)$">
  Require all denied
</FilesMatch>

# Nachweisdatei der Ersteinrichtung. ZWEITE Schranke, nicht die erste:
# Die Kennung steht bereits im DATEINAMEN und ist damit auch dann nicht zu
# erraten, wenn diese Regel nicht greift (anderer Webserver, .htaccess
# abgeschaltet). Ein Verzeichnislisting liefert kein verbreiteter Webserver
# von selbst.
<FilesMatch "^install-nachweis-.*\.txt$">
  Require all denied
</FilesMatch>

# Dasselbe fuer den Nachweis der Wiederherstellung. Er entsteht nur
# auf einer LEEREN Installation oder waehrend eines laufenden Einspielens --
# also genau dann, wenn es noch keine Anmeldung gibt, die ihn schuetzen
# koennte.
<FilesMatch "^wiederher-nachweis-.*\.txt$">
  Require all denied
</FilesMatch>

# Und fuer den Notzugang der einzigen BetreiberIn. Hier
# ist die Richtung umgekehrt: Die Seite NENNT den Namen, die BetreiberIn legt
# die Datei per FTP an (Schreibnachweis). Der Name ist also kein
# Geheimnis -- gesperrt wird trotzdem, weil in der Datei steht, was die
# BetreiberIn hineinlegt, und das soll der Webserver niemandem ausliefern.
<FilesMatch "^zweitfaktor-notweg-.*\.txt$">
  Require all denied
</FilesMatch>

# Security-Header -- NUR FUER DAS, WAS NICHT DURCH PHP LAEUFT.
#
# `kopfzeilen_lib.php` setzt die Kopfzeilen selbst, und zwar auf JEDEM
# Webserver: Diese Datei liest nur Apache. Auf nginx, Caddy oder LiteSpeed
# stuende die Installation sonst ohne `nosniff`, ohne `Referrer-Policy`, ohne
# `X-Frame-Options` und ohne HSTS da, und niemand saehe es. `Header always
# set` hier ERSETZTE, was PHP gesetzt hat.
#
# `setifempty` STATT `set`: Damit fuehrt PHP, wo PHP laeuft, und diese Datei
# springt nur dort ein, wo es nicht laeuft -- bei den statischen Dateien unter
# `assets/` (Stylesheet, Schriften, Symbole, Skripte). Genau die brauchen
# `nosniff` ebenso, und genau die bekommen es von PHP nie.
#
# `Strict-Transport-Security` STEHT HIER NICHT: Die Dauer ist eine
# EINSTELLUNG (Betrieb -> Servereinstellungen, Vorgabe
# **ein Tag**, Stufen 1/7/365). Zwei Stellen fuer dieselbe Kopfzeile waeren
# auf Apache keine Wiederholung, sondern ein Ueberschreiben: Die Einstellung
# haette nichts bewirkt und trotzdem einen Wert angezeigt.
Header always setifempty X-Content-Type-Options "nosniff"
Header always setifempty X-Frame-Options "DENY"
# strict-origin-when-cross-origin: sendet die Herkunft (ohne Pfad) auch an
# fremde Domains -> Kartenkacheln von OpenStreetMap laden wieder.
Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"